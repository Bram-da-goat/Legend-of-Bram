{
  "name": "legend-of-bram-v4",
  "description": "The Legend of Bram V4 — a cinematic Three.js tower-defense RPG.",
  "author": "Bram-da-goat",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "three": "^0.181.1"
  },
  "build": {
    "appId": "com.legendofbram.game",
    "productName": "The Legend of Bram",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
